# ---------------------------------------------------------------------------
# AI E2E Job Portal — configuration
# Copy to `.env` and fill in. Everything here has a working default except the
# API key for whichever cloud provider you pick.
# ---------------------------------------------------------------------------

# === Text LLM backend ======================================================
# gemini         → Google Gemini REST API (current default for testing)
# ollama         → local Ollama daemon (http://localhost:11434)
# openai_compat  → llama.cpp server / vLLM / LM Studio / any OpenAI-compatible API
# fake           → deterministic stub, no network (used by the test suite)
LLM_PROVIDER=gemini

# --- gemini ---
# Multiple keys may be given comma-separated OR via the numbered variants below.
# The provider rotates to the next key when one is rate limited (HTTP 429).
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- openai-compatible (local llama.cpp / vLLM / LM Studio) ---
OPENAI_COMPAT_BASE_URL=http://localhost:8080/v1
OPENAI_COMPAT_MODEL=local-model
OPENAI_COMPAT_API_KEY=not-needed

# --- shared generation settings ---
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# === Speech to text ========================================================
# faster_whisper → fully local, free, no account (recommended)
# gemini         → send audio to Gemini
# disabled       → typed answers only
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LANGUAGE=en

# === Text to speech ========================================================
# pyttsx3 → offline OS voices · piper → local neural voices
# browser → the candidate's browser speaks · disabled → text only
TTS_PROVIDER=pyttsx3
PIPER_MODEL_PATH=
TTS_SPEAKING_RATE=170

# === Interview rules =======================================================
INTERVIEW_PLANNED_QUESTIONS=6
INTERVIEW_MAX_TURNS=9
INTERVIEW_DURATION_MINUTES=30
INTERVIEW_WINDOW_DAYS=7
INTERVIEW_MIN_ANSWER_WORDS=12
INTERVIEW_MAX_ATTEMPTS=1

# === Screening thresholds ==================================================
ATS_REJECT_BELOW=40
SHORTLIST_LLM_SCORE_MIN=15

# === Proctoring ============================================================
PROCTORING_ENABLED=true
PROCTOR_ANALYZE_EVERY_N_FRAMES=5
PROCTOR_RECORD_SESSION=true
PROCTOR_SAVE_SNAPSHOTS=true
PROCTOR_NO_FACE_SECONDS=4
PROCTOR_LOOKING_AWAY_SECONDS=4
PROCTOR_YAW_LIMIT_DEGREES=32
PROCTOR_PITCH_LIMIT_DEGREES=26
PROCTOR_INTEGRITY_FAIL_BELOW=55
# Object/phone detection needs an AGPL-3.0 model. Off by default on purpose.
PROCTOR_OBJECT_DETECTION=false

# === Auth ==================================================================
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
# Anyone with this code can register a recruiter account. Change it.
RECRUITER_INVITE_CODE=change-me-recruiter
ADMIN_EMAIL=admin@portal.local
ADMIN_PASSWORD=change-me-admin

# === Storage ===============================================================
DATABASE_PATH=data/app.db
MEDIA_DIR=data/media
UPLOAD_DIR=data/uploads
LOG_LEVEL=INFO
